#include "skin_resources.h"
#include "meltycat-version.h"
#include <winver.h>

ID_APP_ICON ICON "assets\\meltycat.ico"

ID_SKIN_RAGDOLL RCDATA "skins\\ragdoll.meltycat"
ID_SKIN_RAGDOLL_MIX RCDATA "skins\\ragdoll-mix.meltycat"
ID_SKIN_MAINE_COON RCDATA "skins\\maine-coon.meltycat"
ID_SKIN_SIBERIAN RCDATA "skins\\siberian.meltycat"
ID_SKIN_ORANGE_TABBY RCDATA "skins\\orange-tabby.meltycat"
ID_SKIN_BLACK RCDATA "skins\\black.meltycat"
ID_SKIN_LI_HUA RCDATA "skins\\li-hua.meltycat"
ID_SKIN_CLASSIC_TUXEDO RCDATA "skins\\classic-tuxedo.meltycat"
ID_SKIN_TUXEDO RCDATA "skins\\tuxedo.meltycat"
ID_SKIN_GUIDE RCDATA "skins\\AI-GUIDE.md"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MELTYCAT_VERSION_PARTS
 PRODUCTVERSION MELTYCAT_VERSION_PARTS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "meltycat"
            VALUE "FileVersion", MELTYCAT_VERSION
            VALUE "ProductName", "meltycat"
            VALUE "ProductVersion", MELTYCAT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
